	*  (1) A financial creditor either by itself or jointly with (other financial creditors, or any other person on behalf of the financial creditor, as may be notified by the Central Government) may file an application for initiating corporate insolvency resolution process against a corporate debtor before the Adjudicating Authority when a default has occurred.";}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1762932442;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:11:"last_change";a:10:{s:4:"date";i:1762932442;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:29:"lexai_languages:yscript:code1";s:4:"user";s:0:"";s:3:"sum";s:23:"created - external edit";s:5:"extra";s:0:"";s:10:"sizechange";i:5907;s:9:"timestamp";i:1762932442;s:4:"mode";s:4:"page";}}}
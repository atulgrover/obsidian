The Payment Tracking Agent focuses on monitoring financial obligations arising from a settlement, resolution plan, or liquidation distribution schedule. It tracks payment flows across bank accounts, escrow systems, and digital ledgers, verifying that payments are made as per agreed timelines and amounts. This ensures real-time visibility into creditor recoveries and investor commitments.";}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1761649372;s:8:"modified";i:1761649380;}s:7:"creator";s:11:"Atul Grover";s:4:"user";s:5:"admin";s:11:"last_change";a:9:{s:4:"date";i:1761649380;s:2:"ip";s:13:"49.43.109.130";s:4:"type";s:1:"E";s:2:"id";s:76:"digital_agents:mediation_agents:settlement_monitoring:payment_tracking_agent";s:4:"user";s:5:"admin";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:5;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:5:"admin";s:11:"Atul Grover";}}}
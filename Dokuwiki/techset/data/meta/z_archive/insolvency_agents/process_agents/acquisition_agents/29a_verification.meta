a:2:{s:7:"current";a:8:{s:4:"date";a:2:{s:7:"created";i:1773547242;s:8:"modified";i:1762084970;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:11:"description";a:1:{s:8:"abstract";s:503:"The Section 29A Eligibility Verification Agent assists Insolvency Professionals (IPs) in ensuring that every resolution applicant complies with the disqualification criteria outlined in Section 29A of the Insolvency and Bankruptcy Code (IBC). Before a resolution plan can be considered by the Committee of Creditors (CoC), the IP must confirm that the applicant is not ineligible due to factors like prior loan defaults, NPA status, or connections with disqualified entities. This agent automates the…";}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}s:5:"title";N;s:11:"last_change";a:4:{s:4:"date";N;s:4:"user";N;s:2:"ip";N;s:3:"sum";N;}}s:10:"persistent";a:3:{s:4:"date";a:1:{s:7:"created";i:1773547242;}s:4:"user";s:0:"";s:7:"creator";s:0:"";}}
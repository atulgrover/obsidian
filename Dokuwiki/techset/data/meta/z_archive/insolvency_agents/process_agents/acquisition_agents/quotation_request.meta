a:2:{s:7:"current";a:8:{s:4:"date";a:2:{s:7:"created";i:1773547242;s:8:"modified";i:1761647511;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:11:"description";a:1:{s:8:"abstract";s:505:"The Quotation Request Agent is designed to streamline the professional engagement process for Insolvency Professionals (IPs) during CIRP and liquidation assignments. Under the IBC framework, IPs must appoint valuers, auditors, legal advisors, and other experts through a transparent and competitive quotation process. This agent automates the drafting and dispatch of standardized quotation request emails, ensuring that each communication is consistent, compliant, and aligned with IBBI’s ethical an…";}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}s:5:"title";N;s:11:"last_change";a:4:{s:4:"date";N;s:4:"user";N;s:2:"ip";N;s:3:"sum";N;}}s:10:"persistent";a:3:{s:4:"date";a:1:{s:7:"created";i:1773547242;}s:4:"user";s:0:"";s:7:"creator";s:0:"";}}
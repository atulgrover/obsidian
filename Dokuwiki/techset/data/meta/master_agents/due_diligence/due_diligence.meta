a:2:{s:7:"current";a:8:{s:4:"date";a:2:{s:7:"created";i:1761239400;s:8:"modified";i:1761232323;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:5:"title";s:26:"AI Agents in Due Diligence";s:11:"description";a:2:{s:15:"tableofcontents";a:5:{i:0;a:4:{s:3:"hid";s:26:"ai_agents_in_due_diligence";s:5:"title";s:26:"AI Agents in Due Diligence";s:4:"type";s:2:"ul";s:5:"level";i:2;}i:1;a:4:{s:3:"hid";s:81:"company_due_diligence_agent_collect_and_verify_company_data_and_financial_history";s:5:"title";s:86:"1. Company Due Diligence Agent (Collect and Verify Company Data and Financial History)";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:2;a:4:{s:3:"hid";s:66:"creditor_identification_agent_collect_and_verify_creditor_exposure";s:5:"title";s:71:"2. Creditor Identification Agent (Collect and Verify Creditor Exposure)";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:3;a:4:{s:3:"hid";s:69:"financial_health_diagnostic_agent_verify_financial_history_and_health";s:5:"title";s:74:"3. Financial Health Diagnostic Agent (Verify Financial History and Health)";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:4;a:4:{s:3:"hid";s:14:"overall_impact";s:5:"title";s:14:"Overall Impact";s:4:"type";s:2:"ul";s:5:"level";i:2;}}s:8:"abstract";s:444:"The stage of Due Diligence—focused on collecting and verifying company data, financial history, and creditor exposure—is heavily supported by the sources as a primary application area for Artificial Intelligence (AI) and technology-assisted tools in insolvency and restructuring. AI's ability to process vast amounts of complex data quickly and accurately is essential for the Insolvency Professional (IP) to perform this foundational work.";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}s:11:"last_change";a:10:{s:4:"date";i:1761232323;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:41:"master_agents:due_diligence:due_diligence";s:4:"user";s:0:"";s:3:"sum";s:23:"created - external edit";s:5:"extra";s:0:"";s:10:"sizechange";i:4644;s:9
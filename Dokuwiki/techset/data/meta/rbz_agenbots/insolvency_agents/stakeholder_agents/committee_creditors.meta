CREDITOR COMMITTEES - The Committee of Creditors (CoC) is formed by financial creditors and plays a pivotal role in CIRP. It evaluates resolution plans, monitors the insolvency professional’s actions, and ensures decisions align with value maximization and fairness. The CoC serves as the final authority on accepting or rejecting resolution plans. Committee of Creditors plays a central role in the insolvency resolution process, and AI-driven agents can…";}s:8:"relation";a:2:{s:10:"references";a:8:{s:108:"rbz_agenbots:insolvency_agents:stakeholder_agents:committee_creditors:voting_and_decision_support_agent_vdsa";b:1;s:113:"rbz_agenbots:insolvency_agents:stakeholder_agents:committee_creditors:financial_information_management_agent_fima";b:1;s:107:"rbz_agenbots:insolvency_agents:stakeholder_agents:committee_creditors:resolution_plan_evaluation_agent_rpea";b:1;s:111:"rbz_agenbots:insolvency_agents:stakeholder_agents:committee_creditors:communication_and_collaboration_agent_cca";b:1;s:111:"rbz_agenbots:insolvency_agents:stakeholder_agents:committee_creditors:risk_assessment_and_mitigation_agent_rama";b:1;s:116:"rbz_agenbots:insolvency_agents:stakeholder_agents:committee_creditors:regulatory_compliance_and_reporting_agent_rcra";b:1;s:113:"rbz_agenbots:insolvency_agents:stakeholder_agents:committee_creditors:asset_valuation_and_optimization_agent_avoa";b:1;s:104:"rbz_agenbots:insolvency_agents:stakeholder_agents:committee_creditors:monitoring_and_oversight_agent_moa";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:0;}}s:10:"persistent";a:6:{s:4:"date";a:2:{s:7:"created";i:1762260308;s:8:"modified";i:1762776479;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:11:"last_change";a:9:{s:4:"date";i:1762776479;s:2:"ip";s:11:"49.43.111.6";s:4:"type";s:1:"E";s:2:"id";s:69:"rbz_agenbots:insolvency_agents:stakeholder_agents:committee_creditors";s:4:"user";s:5:"admin";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:592;s:4:"mode";s:4:"page";}s:12:"plugi
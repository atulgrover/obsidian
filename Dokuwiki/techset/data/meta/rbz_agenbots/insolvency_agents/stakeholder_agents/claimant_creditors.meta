CLAIMANTS - Creditor claimants are individuals or entities with financial claims against the corporate debtor. They include financial creditors, operational creditors, and secured creditors, each with distinct rights under the IBC framework. Their claims are verified and prioritized during CIRP to ensure equitable distribution of recovered assets. Claimants play a pivotal role in guiding creditors through the claim submission, verification, and status tracking pro…";}s:8:"relation";a:2:{s:10:"references";a:8:{s:113:"rbz_agenbots:insolvency_agents:stakeholder_agents:claimant_creditors:claim_verification_and_validation_agent_cvva";b:1;s:109:"rbz_agenbots:insolvency_agents:stakeholder_agents:claimant_creditors:priority_and_ranking_analysis_agent_praa";b:1;s:108:"rbz_agenbots:insolvency_agents:stakeholder_agents:claimant_creditors:insolvency_process_navigator_agent_ipna";b:1;s:110:"rbz_agenbots:insolvency_agents:stakeholder_agents:claimant_creditors:settlement_negotiation_support_agent_snsa";b:1;s:111:"rbz_agenbots:insolvency_agents:stakeholder_agents:claimant_creditors:asset_recovery_and_distribution_agent_arda";b:1;s:115:"rbz_agenbots:insolvency_agents:stakeholder_agents:claimant_creditors:regulatory_compliance_and_reporting_agent_rcra";b:1;s:103:"rbz_agenbots:insolvency_agents:stakeholder_agents:claimant_creditors:financial_data_analysis_agent_fdaa";b:1;s:120:"rbz_agenbots:insolvency_agents:stakeholder_agents:claimant_creditors:stakeholder_communication_and_management_agent_scma";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:0;}}s:10:"persistent";a:6:{s:4:"date";a:2:{s:7:"created";i:1762260308;s:8:"modified";i:1762776187;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:11:"last_change";a:9:{s:4:"date";i:1762776187;s:2:"ip";s:11:"49.43.111.6";s:4:"type";s:1:"E";s:2:"id";s:68:"rbz_agenbots:insolvency_agents:stakeholder_agents:claimant_creditors";s:4:"user";s:5:"admin";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:584;s:4:"mode";s:4:"
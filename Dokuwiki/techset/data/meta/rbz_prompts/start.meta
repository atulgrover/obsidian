a:2:{s:7:"current";a:9:{s:4:"date";a:2:{s:7:"created";i:1764227056;s:8:"modified";i:1764643578;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:11:"last_change";a:9:{s:4:"date";i:1764643578;s:2:"ip";s:13:"49.43.109.222";s:4:"type";s:1:"E";s:2:"id";s:17:"rbz_prompts:start";s:4:"user";s:5:"admin";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:-306;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:5:"admin";s:11:"Atul Grover";}s:5:"title";s:18:"What is Prompting?";s:11:"description";a:2:{s:15:"tableofcontents";a:2:{i:0;a:4:{s:3:"hid";s:17:"what_is_prompting";s:5:"title";s:18:"What is Prompting?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:1;a:4:{s:3:"hid";s:24:"prompting_best_practices";s:5:"title";s:24:"Prompting Best Practices";s:4:"type";s:2:"ul";s:5:"level";i:3;}}s:8:"abstract";s:473:"The rise of large language models has created new possibilities for how humans interact with computers. To make the most of these systems, it is essential to understand how to guide them. Prompt engineering is the skill of crafting prompts that help LLMs understand intent, follow instructions, and produce accurate and relevant output. As AI becomes part of more applications, this skill becomes increasingly important for ensuring useful, reliable, and safe interactions.";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:0;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1764227056;s:8:"modified";i:1764643578;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:11:"last_change";a:9:{s:4:"date";i:1764643578;s:2:"ip";s:13:"49.43.109.222";s:4:"type";s:1:"E";s:2:"id";s:17:"rbz_prompts:start";s:4:"user";s:5:"admin";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:-306;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:5:"admin";s:11:"Atul Grover";}}}
                    "lineCount": 7,
                    "x": 105.74,
                    "width": 442.52711999999985,
                    "isHeading": false,
                    "headingLevel": 3
                },
                {
                    "text": "b.The CIAN Group is an integrated group with expanse andexpertiseindiversesectors-Spice,EdibleOil, Personal Care, Home Care, Sanitation and Argo.",
                    "y": 535.87,
                    "height": 33.11999999999989,
                    "avgFontSize": 11.04,
                    "lineCount": 3,
                    "x": 245.93,
                    "width": 302.58632000000017,
                    "isHeading": false,
                    "headingLevel": 3
                },

8;s:8:"fontSize";i:12;s:10:"fontFamily";s:7:"unknown";s:10:"confidence";i:1;s:9:"lineCount";i:4;s:9:"isHeading";b:0;s:12:"headingLevel";i:0;s:6:"isList";b:0;s:8:"isFooter";b:0;s:7:"isTable";b:0;}}}}s:8:"metadata";a:2:{s:10:"totalPages";i:2;s:14:"characterCount";i:2868;}}s:4:"hash";s:32:"ed8b42f6b336af21f71a21ae34673774";}i:2;i:5;i:3;s:31291:"<liteparse-json hash="ed8b42f6b336af21f71a21ae34673774">

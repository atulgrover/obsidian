CORPORATE DEBTORS - Corporate debtors are entities that have defaulted on their financial obligations, triggering insolvency proceedings under the IBC. They are central to the resolution process, as their assets and operations are managed to maximize value for creditors. During the Corporate Insolvency Resolution Process (CIRP), control shifts from the corporate debtor's management to insolvency professionals.";}s:8:"relation";a:3:{s:5:"media";a:2:{s:15:"wiki:lexai1.png";b:1;s:21:"wiki:request_demo.jpg";b:1;}s:10:"references";a:1:{s:26:"request_forms:debtor_forms";b:1;}s:10:"firstimage";s:15:"wiki:lexai1.png";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:0;}s:11:"last_change";a:10:{s:4:"date";i:1744439873;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:39:"agents:stakeholder_agents:debtor_agents";s:4:"user";s:0:"";s:3:"sum";s:23:"created - external edit";s:5:"extra";s:0:"";s:10:"sizechange";i:2985;s:9:"timestamp";i:1744439873;s:4:"mode";s:4:"page";}s:6:"plugin";a:1:{s:13:"plugin_acmenu";a:1:{s:6:"sub_ns";a:3:{i:0;s:25:"agents:stakeholder_agents";i:1;s:6:"agents";i:2;s:0:"";}}}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1744525325;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:11:"last_change";a:10:{s:4:"date";i:1744439873;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:39:"agents:stakeholder_agents:debtor_agents";s:4:"user";s:0:"";s:3:"sum";s:23:"created - external edit";s:5:"extra";s:0:"";s:10:"sizechange";i:2985;s:9:"timestamp";i:1744439873;s:4:"mode";s:4:"page";}}}